From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: m <m@linuxistsuper.de>
Date: Fri, 16 Oct 2026 14:27:45 +0200
Subject: [PATCH 2/2] Build as io.music_assistant.client.patched

Separate application id, version suffix and label so the fork build installs
next to the official (differently signed) app.
---
 androidApp/build.gradle.kts                        |  6 ++++++
 androidApp/src/main/res/values/strings.xml         |  2 +-
 androidApp/src/main/res/xml/shortcuts.xml          | 14 +++++++-------
 .../client/auto/AndroidAutoArtworkUriTest.kt       |  4 ++--
 4 files changed, 16 insertions(+), 10 deletions(-)

diff --git a/androidApp/build.gradle.kts b/androidApp/build.gradle.kts
index 3ce9d1dd..bf514a4d 100644
--- a/androidApp/build.gradle.kts
+++ b/androidApp/build.gradle.kts
@@ -185,3 +185,9 @@ androidComponents {
     }
 }
 
+// Fork build: its own application id, so it installs next to the official app
+// (which is signed with a different key).
+android.defaultConfig {
+    applicationId = "io.music_assistant.client.patched"
+    versionNameSuffix = "-patched"
+}
diff --git a/androidApp/src/main/res/values/strings.xml b/androidApp/src/main/res/values/strings.xml
index 5050736e..40de2ff6 100755
--- a/androidApp/src/main/res/values/strings.xml
+++ b/androidApp/src/main/res/values/strings.xml
@@ -1,3 +1,3 @@
 <resources>
-    <string name="app_name">Music Assistant</string>
+    <string name="app_name">Music Assistant (patched)</string>
 </resources>
\ No newline at end of file
diff --git a/androidApp/src/main/res/xml/shortcuts.xml b/androidApp/src/main/res/xml/shortcuts.xml
index 3b14d4da..8bef4037 100644
--- a/androidApp/src/main/res/xml/shortcuts.xml
+++ b/androidApp/src/main/res/xml/shortcuts.xml
@@ -33,7 +33,7 @@
         <!-- Artist: "play Radiohead", "play music by Daft Punk" -->
         <intent
             android:action="android.media.action.MEDIA_PLAY_FROM_SEARCH"
-            android:targetPackage="io.music_assistant.client"
+            android:targetPackage="io.music_assistant.client.patched"
             android:targetClass="io.music_assistant.client.VoicePlayDispatchActivity">
             <parameter
                 android:name="media.@type"
@@ -53,7 +53,7 @@
         <!-- Album: "play OK Computer", "play the album Dark Side of the Moon by Pink Floyd" -->
         <intent
             android:action="android.media.action.MEDIA_PLAY_FROM_SEARCH"
-            android:targetPackage="io.music_assistant.client"
+            android:targetPackage="io.music_assistant.client.patched"
             android:targetClass="io.music_assistant.client.VoicePlayDispatchActivity">
             <parameter
                 android:name="media.@type"
@@ -76,7 +76,7 @@
         <!-- Song / Track: "play Bohemian Rhapsody", "play Yesterday by The Beatles" -->
         <intent
             android:action="android.media.action.MEDIA_PLAY_FROM_SEARCH"
-            android:targetPackage="io.music_assistant.client"
+            android:targetPackage="io.music_assistant.client.patched"
             android:targetClass="io.music_assistant.client.VoicePlayDispatchActivity">
             <parameter
                 android:name="media.@type"
@@ -99,7 +99,7 @@
         <!-- Playlist: "play my Workout playlist" -->
         <intent
             android:action="android.media.action.MEDIA_PLAY_FROM_SEARCH"
-            android:targetPackage="io.music_assistant.client"
+            android:targetPackage="io.music_assistant.client.patched"
             android:targetClass="io.music_assistant.client.VoicePlayDispatchActivity">
             <parameter
                 android:name="media.@type"
@@ -119,7 +119,7 @@
         <!-- Podcast: "play the Daily podcast" — falls through to unstructured cascade -->
         <intent
             android:action="android.media.action.MEDIA_PLAY_FROM_SEARCH"
-            android:targetPackage="io.music_assistant.client"
+            android:targetPackage="io.music_assistant.client.patched"
             android:targetClass="io.music_assistant.client.VoicePlayDispatchActivity">
             <parameter
                 android:name="media.@type"
@@ -133,7 +133,7 @@
         <!-- Radio station: "play KEXP", "play BBC Radio 6" — unstructured cascade -->
         <intent
             android:action="android.media.action.MEDIA_PLAY_FROM_SEARCH"
-            android:targetPackage="io.music_assistant.client"
+            android:targetPackage="io.music_assistant.client.patched"
             android:targetClass="io.music_assistant.client.VoicePlayDispatchActivity">
             <parameter
                 android:name="media.@type"
@@ -147,7 +147,7 @@
         <!-- Generic fallback: any PLAY_MEDIA without a recognised @type — unstructured -->
         <intent
             android:action="android.media.action.MEDIA_PLAY_FROM_SEARCH"
-            android:targetPackage="io.music_assistant.client"
+            android:targetPackage="io.music_assistant.client.patched"
             android:targetClass="io.music_assistant.client.VoicePlayDispatchActivity">
             <parameter
                 android:name="media.name"
diff --git a/androidApp/src/test/kotlin/io/music_assistant/client/auto/AndroidAutoArtworkUriTest.kt b/androidApp/src/test/kotlin/io/music_assistant/client/auto/AndroidAutoArtworkUriTest.kt
index f1da9667..518c3268 100644
--- a/androidApp/src/test/kotlin/io/music_assistant/client/auto/AndroidAutoArtworkUriTest.kt
+++ b/androidApp/src/test/kotlin/io/music_assistant/client/auto/AndroidAutoArtworkUriTest.kt
@@ -215,7 +215,7 @@ class AndroidAutoArtworkUriTest {
     )
 
     private companion object {
-        const val AUTHORITY = "io.music_assistant.client.autoartwork"
-        val DEFAULT_ICON: Uri = Uri.parse("android.resource://io.music_assistant.client/drawable/default")
+        const val AUTHORITY = "io.music_assistant.client.patched.autoartwork"
+        val DEFAULT_ICON: Uri = Uri.parse("android.resource://io.music_assistant.client.patched/drawable/default")
     }
 }
